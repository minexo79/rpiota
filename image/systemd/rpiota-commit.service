[Unit]
Description=Commit or roll back after an OTA tryboot
RequiresMountsFor=/persistent /bootfs
# 只排在要檢查的服務後面；不可 After=multi-user.target（順序循環）
Wants=ssh.service avahi-daemon.service rpiota-web.service rpiota-hello.service
After=ssh.service avahi-daemon.service rpiota-web.service rpiota-hello.service
FailureAction=reboot

[Service]
Type=oneshot
Environment=PYTHONPATH=/usr/lib/rpiota
ExecStart=/usr/bin/python3 -m rpiota.commit
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
